# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Local runs
local-output/
*.local.csv

# Terraform (state is sensitive -- never commit it)
# Note: .terraform.lock.hcl is deliberately NOT ignored -- commit it, it
# pins provider versions and contains no secrets.
infra/**/.terraform/
infra/**/terraform.tfstate
infra/**/terraform.tfstate.*
infra/**/*.tfplan
infra/**/tfplan
infra/**/crash.log
infra/**/override.tf
infra/**/override.tf.json
infra/**/*_override.tf
infra/**/*_override.tf.json

# Env / secrets
.env
.env.*
*.pem

# Lambda build artifacts
infra/lambda/build/
infra/lambda/*.zip

# OS
.DS_Store

# Terraform backend + variable files (account-specific; commit the *.example)
infra/**/backend.hcl
infra/**/*.backend.hcl
infra/**/*.tfvars
infra/**/*.tfvars.json
!infra/**/*.tfvars.example

# Hypothesis example database
.hypothesis/
!infra/**/*.backend.hcl.example

# Coverage data
.coverage
coverage.md
